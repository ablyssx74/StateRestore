resource app_signature "application/x-vnd.ablyss-StateRestore";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,

	variety = B_APPV_FINAL,
	internal = 0,

	short_info = "State Restore",
	long_info = "Go back to an earlier state of the system's packages, without the boot menu."
};
